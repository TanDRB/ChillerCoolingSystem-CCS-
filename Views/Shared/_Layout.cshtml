<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Chiller Cooling System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/extruder.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/weight.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <div class="app-main">
            @await Html.PartialAsync("_Header")
            <div class="app-content custom-scroll">
                @RenderBody()
            </div>
        </div>
    </div>
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    <script src="~/js/photo-keying.js" asp-append-version="true"></script>
    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/js/poller.js" asp-append-version="true"></script>
    <script src="~/js/extruder.js" asp-append-version="true"></script>
    <script src="~/js/weight.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
</body>
</html>
