@using ChillerCoolingSystem_CCS_.Models.Dto
@model List<DashboardZoneDto>
@{
    string Camel(string s) => string.IsNullOrEmpty(s) ? s : char.ToLowerInvariant(s[0]) + s[1..];
    string ElementId(string machineKey, string parameterKey) => $"{machineKey}-{Camel(parameterKey)}";
    bool IsToggleIcon(string kind) => kind == "Status" || kind == "Fault";
}

<div class="plant-zones">
    @foreach (var zone in Model)
    {
        <div class="plant-zone">
            <div class="card ct-card">
                <div class="ct-head">
                    <div>
                        <div class="ct-title">@zone.Ct.Name</div>
                        <div class="ct-desc">@zone.Ct.Location</div>
                    </div>
                    <div class="status-pill status-run" id="@(zone.Ct.Key)-status-pill">
                        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
                        <span id="@(zone.Ct.Key)-status-text">START</span>
                    </div>
                </div>
                <div class="ct-content">
                    <div class="ct-photo">
                        <img src="@zone.Ct.ImageUrl" alt="@zone.Ct.Type" />
                    </div>
                    <div class="ct-params">
                        @foreach (var p in zone.Ct.Parameters.Where(p => p.Kind != "ErrorFlag").OrderBy(p => p.Kind == "Temperature" ? 0 : 1))
                        {
                            var valueId = ElementId(zone.Ct.Key, p.ParameterKey);
                            var iconId = IsToggleIcon(p.Kind) ? $"{valueId}-icon" : null;
                            var valueClass = IsToggleIcon(p.Kind) ? "green" : "";
                            <div class="param-row">
                                @await Html.PartialAsync("_ParamIcon", new ParamIconVm { IconKey = p.IconKey, Id = iconId, Compact = false })
                                <div class="param-text"><div class="param-label" data-i18n="@p.LabelKey"></div></div>
                                <div class="param-value @valueClass" id="@valueId">--</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="@(zone.Chillers.Count >= 3 ? "zone-connector zone-connector-3" : "zone-connector")">
                @for (int i = 0; i < zone.Chillers.Count; i++)
                {
                    <div class="zone-connector-branch"></div>
                }
            </div>

            <div class="@(zone.Chillers.Count >= 3 ? "zone-chillers zone-chillers-3" : "zone-chillers")">
                @foreach (var chiller in zone.Chillers)
                {
                    <div class="card chiller-card">
                        <div class="chiller-head">
                            <div>
                                <div class="chiller-title">@chiller.Name</div>
                                <div class="chiller-sub">@chiller.Location</div>
                            </div>
                            <div class="status-pill status-run" id="@(chiller.Key)-status-pill">
                                <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5Z" /></svg>
                                <span id="@(chiller.Key)-status-text">START</span>
                            </div>
                        </div>
                        <div class="chiller-photo">
                            <img src="@chiller.ImageUrl" alt="@chiller.Type" />
                        </div>
                        <div class="chiller-params">
                            @foreach (var p in chiller.Parameters.Where(p => p.Kind != "ErrorFlag"))
                            {
                                var valueId = ElementId(chiller.Key, p.ParameterKey);
                                var iconId = IsToggleIcon(p.Kind) ? $"{valueId}-icon" : null;
                                var valueClass = IsToggleIcon(p.Kind) ? "green" : "";
                                <div class="param-row">
                                    @await Html.PartialAsync("_ParamIcon", new ParamIconVm { IconKey = p.IconKey, Id = iconId, Compact = true })
                                    <div class="param-text"><div class="param-label" data-i18n="@p.LabelKey"></div></div>
                                    <div class="param-value @valueClass" id="@valueId">--</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div class="statbar">

    <div class="stat-box legend-box">
        <div class="legend-title" data-i18n="systemStatus">TRẠNG THÁI HỆ THỐNG</div>
        <div class="legend-row"><span class="legend-dot" style="background:#22c55e;"></span><span data-i18n="legendRunning">Hoạt động</span><span class="legend-count" id="legend-running">--</span></div>
        <div class="legend-row"><span class="legend-dot" style="background:#ef4444;"></span><span data-i18n="legendStopped">Dừng</span><span class="legend-count" id="legend-stopped">--</span></div>
        <div class="legend-row"><span class="legend-dot" style="background:#94a3b8;"></span><span data-i18n="legendError">Lỗi</span><span class="legend-count" id="legend-error">--</span></div>
    </div>

    <div class="stat-box">
        <div class="stat-icon ic-blue">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="12" rx="1.5" /><line x1="8" y1="20" x2="16" y2="20" /><line x1="12" y1="16.5" x2="12" y2="20" /></svg>
        </div>
        <div>
            <div class="stat-value" id="stat-total">--</div>
            <div class="stat-label" data-i18n="totalMachines">TỔNG SỐ MÁY</div>
        </div>
    </div>

    <div class="stat-box">
        <div class="stat-icon ic-green">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M10 8.5v7l6-3.5-6-3.5Z" fill="currentColor" stroke="none" /></svg>
        </div>
        <div>
            <div class="stat-value" id="stat-running">--</div>
            <div class="stat-label" data-i18n="runningLabel">ĐANG HOẠT ĐỘNG</div>
            <div class="stat-sub" style="color:#22c55e;" id="stat-running-pct">--</div>
        </div>
    </div>

    <div class="stat-box">
        <div class="stat-icon ic-red">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><rect x="9" y="9" width="6" height="6" rx="1" fill="currentColor" stroke="none" /></svg>
        </div>
        <div>
            <div class="stat-value" id="stat-stopped">--</div>
            <div class="stat-label" data-i18n="stoppedLabel">ĐANG DỪNG</div>
            <div class="stat-sub" style="color:#ef4444;" id="stat-stopped-pct">--</div>
        </div>
    </div>

    <div class="stat-box">
        <div class="stat-icon ic-orange">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 21 19H3L12 3.5Z" /><line x1="12" y1="9.5" x2="12" y2="13.5" /><circle cx="12" cy="16.3" r="0.9" fill="currentColor" stroke="none" /></svg>
        </div>
        <div>
            <div class="stat-value" id="stat-error">--</div>
            <div class="stat-label" data-i18n="errorLabel">ĐANG LỖI</div>
            <div class="stat-sub" style="color:#f59e0b;" id="stat-error-pct">--</div>
        </div>
    </div>

    <div class="stat-box sys-box">
        <div class="legend-title" data-i18n="exportTitle">Truy xuất dữ liệu</div>
        <div class="sys-export-dates">
            <div class="sys-export-field">
                <label class="sys-export-label" for="exportFrom" data-i18n="exportFrom">Từ ngày</label>
                <input type="date" id="exportFrom" class="sys-export-date" />
            </div>
            <div class="sys-export-field">
                <label class="sys-export-label" for="exportTo" data-i18n="exportTo">Đến ngày</label>
                <input type="date" id="exportTo" class="sys-export-date" />
            </div>
        </div>
        <button type="button" class="sys-export-btn" id="exportExcelBtn" data-i18n="exportExcel">Xuất Excel</button>
    </div>

</div>

@section Scripts {
    @{
        // Dữ liệu cho script bên dưới đi qua thuộc tính data-* (thay vì nhúng Razor trong JS) để trình soạn thảo không báo lỗi cú pháp JS.
        var allMachines = Model.SelectMany(z => new[] { z.Ct }.Concat(z.Chillers)).ToList();
        var machineKeysJson = System.Text.Json.JsonSerializer.Serialize(allMachines.Select(m => m.Key));
        var machinesJson = System.Text.Json.JsonSerializer.Serialize(allMachines.Select(m => new
        {
            key = m.Key,
            parameters = m.Parameters.Select(p => new
            {
                parameterKey = p.ParameterKey,
                kind = p.Kind,
                unit = p.Unit,
                linkedParameterKey = p.LinkedParameterKey
            })
        }));
    }
    <div id="ccsMachineData" hidden data-keys="@machineKeysJson" data-machines="@machinesJson"></div>
    <script src="~/js/photo-keying.js"></script>
    <script>
        window.ccsKeyWhiteBackground('.ct-photo img, .chiller-photo img');
    </script>
    <script>
        (function () {
            var exportBtn = document.getElementById('exportExcelBtn');
            var fromInput = document.getElementById('exportFrom');
            var toInput = document.getElementById('exportTo');

            function toDateInputValue(d) {
                return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
            }

            if (fromInput && toInput) {
                var today = new Date();
                var weekAgo = new Date();
                weekAgo.setDate(today.getDate() - 6);
                fromInput.value = toDateInputValue(weekAgo);
                toInput.value = toDateInputValue(today);
                toInput.max = toDateInputValue(today);
            }

            if (exportBtn) {
                var ALL_MACHINE_KEYS = JSON.parse(document.getElementById('ccsMachineData').dataset.keys);

                exportBtn.addEventListener('click', function () {
                    if (!fromInput.value || !toInput.value) {
                        return;
                    }

                    var qs = 'fromDate=' + encodeURIComponent(fromInput.value) + '&toDate=' + encodeURIComponent(toInput.value) +
                        ALL_MACHINE_KEYS.map(function (k) { return '&machineKeys=' + encodeURIComponent(k); }).join('');
                    window.location.href = '/Home/ExportExcel?' + qs;
                });
            }
        })();
    </script>

    <script>
        (function () {
            if (!window.signalR) {
                console.warn('SignalR chưa load, bỏ qua realtime.');
                return;
            }

            var MACHINES = JSON.parse(document.getElementById('ccsMachineData').dataset.machines);

            var MACHINE_KEYS = MACHINES.map(function (m) { return m.key; });

            function camel(s) {
                return s.length === 0 ? s : s[0].toLowerCase() + s.slice(1);
            }

            function setTempCell(id, tag, errorTag) {
                var el = document.getElementById(id);
                if (!el || !tag) {
                    return;
                }

                var isError = !!errorTag && errorTag.good && errorTag.value !== '0';

                if (tag.good && tag.value !== null && tag.value !== undefined) {
                    el.textContent = tag.value + ' °C';
                } else {
                    el.textContent = '--';
                }

                el.classList.toggle('red', !tag.good || isError);

                var row = el.closest('.param-row');
                (row || el).classList.toggle('blink-alert', isError);
            }

            function setIconTone(id, tone) {
                var el = document.getElementById(id);
                if (!el) {
                    return;
                }

                el.classList.remove('ic-green', 'ic-red', 'ic-gray');
                el.classList.add('ic-' + tone);
            }

            function setRunStopCell(prefix, tag) {
                var el = document.getElementById(prefix + '-runStop');
                var pill = document.getElementById(prefix + '-status-pill');
                var pillText = document.getElementById(prefix + '-status-text');

                if (!tag || !tag.good) {
                    if (el) { el.textContent = '--'; el.classList.remove('green', 'red'); }
                    setIconTone(prefix + '-runStop-icon', 'gray');
                    return;
                }

                var isRun = tag.value === '1';
                var t = window.ccsT || function (k) { return k; };

                if (el) {
                    el.textContent = isRun ? t('RUN') : t('STOP');
                    el.classList.toggle('green', isRun);
                    el.classList.toggle('red', !isRun);
                }

                setIconTone(prefix + '-runStop-icon', isRun ? 'green' : 'red');

                if (pill) {
                    pill.classList.toggle('status-run', isRun);
                    pill.classList.toggle('status-stop', !isRun);
                }

                if (pillText) {
                    pillText.textContent = isRun ? t('START') : t('STOP');
                }
            }

            function setFaultCell(prefix, tag) {
                var el = document.getElementById(prefix + '-fault');
                if (!el) {
                    return;
                }

                var row = el.closest('.param-row');

                if (!tag || !tag.good) {
                    el.textContent = '--';
                    el.classList.remove('green', 'red');
                    (row || el).classList.remove('blink-alert');
                    setIconTone(prefix + '-fault-icon', 'gray');
                    return;
                }

                var isNormal = tag.value === '0';
                var t = window.ccsT || function (k) { return k; };
                el.textContent = isNormal ? t('Normal') : (t('legendError') + ' (' + tag.value + ')');
                el.classList.toggle('green', isNormal);
                el.classList.toggle('red', !isNormal);
                (row || el).classList.toggle('blink-alert', !isNormal);
                setIconTone(prefix + '-fault-icon', isNormal ? 'green' : 'red');
            }

            function setRawCell(id, tag, errorTag, unit) {
                var el = document.getElementById(id);
                if (!el || !tag) {
                    return;
                }

                var isError = !!errorTag && errorTag.good && errorTag.value !== '0';
                var hasValue = tag.good && tag.value !== null && tag.value !== undefined;

                el.textContent = hasValue ? (tag.value + (unit ? ' ' + unit : '')) : '--';
                el.classList.toggle('red', !tag.good || isError);

                var row = el.closest('.param-row');
                (row || el).classList.toggle('blink-alert', isError);
            }

            var lastSnapshot = null;

            window.ccsRefreshDynamicLabels = function () {
                if (lastSnapshot) {
                    applySnapshot(lastSnapshot);
                }
            };

            function applySnapshot(snapshot) {
                if (!snapshot) {
                    return;
                }

                lastSnapshot = snapshot;

                MACHINES.forEach(function (m) {
                    m.parameters.forEach(function (p) {
                        if (p.kind === 'ErrorFlag') {
                            return;
                        }

                        var valueId = m.key + '-' + camel(p.parameterKey);
                        var tag = snapshot[m.key + p.parameterKey];

                        if (p.kind === 'Status') {
                            setRunStopCell(m.key, tag);
                            return;
                        }

                        if (p.kind === 'Fault') {
                            setFaultCell(m.key, tag);
                            return;
                        }

                        var errorParam = m.parameters.filter(function (x) {
                            return x.kind === 'ErrorFlag' && x.linkedParameterKey === p.parameterKey;
                        })[0];
                        var errorTag = errorParam ? snapshot[m.key + errorParam.parameterKey] : null;

                        if (p.kind === 'Temperature') {
                            setTempCell(valueId, tag, null);
                        } else if (p.kind === 'Pressure') {
                            setRawCell(valueId, tag, errorTag, p.unit);
                        }
                    });
                });

                updateSummary(snapshot);
            }

            function classifyMachine(snapshot, key) {
                var runStop = snapshot[key + 'RunStop'];
                var fault = snapshot[key + 'Fault'];

                if (!runStop || !runStop.good || !fault || !fault.good) {
                    return 'error';
                }

                if (fault.value !== '0') {
                    return 'error';
                }

                return runStop.value === '1' ? 'running' : 'stopped';
            }

            function formatPercent(count, total) {
                if (total <= 0) {
                    return '0.0%';
                }

                return (count / total * 100).toFixed(1) + '%';
            }

            function setText(id, text) {
                var el = document.getElementById(id);
                if (el) {
                    el.textContent = text;
                }
            }

            function updateSummary(snapshot) {
                var running = 0, stopped = 0, error = 0;

                MACHINE_KEYS.forEach(function (key) {
                    var status = classifyMachine(snapshot, key);
                    if (status === 'running') running++;
                    else if (status === 'stopped') stopped++;
                    else error++;
                });

                var total = MACHINE_KEYS.length;

                setText('stat-total', String(total));

                setText('legend-running', String(running));
                setText('legend-stopped', String(stopped));
                setText('legend-error', String(error));

                setText('stat-running', String(running));
                setText('stat-running-pct', formatPercent(running, total));

                setText('stat-stopped', String(stopped));
                setText('stat-stopped-pct', formatPercent(stopped, total));

                setText('stat-error', String(error));
                setText('stat-error-pct', formatPercent(error, total));
            }

            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/chiller-realtime')
                .withAutomaticReconnect([0, 1000, 3000, 5000])
                .build();

            connection.on('MachineUpdate', applySnapshot);

            connection.start().catch(function (err) {
                console.error('Kết nối SignalR (chiller-realtime) thất bại:', err);
            });
        })();
    </script>
}
